DATABASE_URL=postgresql://postgres:postgres@db:5432/wellness_db
SECRET_KEY=change-this-secret-key
OPENAI_API_KEY=
ENFORCE_HTTPS=false
# Optional Fernet key (urlsafe base64, 32-byte key). If omitted, key derived from SECRET_KEY.
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=abcd1234efgh5678
SMTP_FROM_EMAIL=youraddress@gmail.com
# false for 587 (STARTTLS), true for 465 (implicit TLS)
SMTP_USE_TLS=false

FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:8001
